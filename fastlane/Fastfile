default_platform(:android)

platform :android do
  desc "Assemble the signed release bundle"
  lane :build do
    gradle(
      task: 'bundleRelease',
      project_dir: '..',
      properties: signing_properties,
    )
  end

  desc "Run ktlint, unit tests and the debug build in one go"
  lane :verify do
    sh('cd .. && ./gradlew ktlintCheck test assembleDebug')
  end

  desc "Run the Android lint checks"
  lane :lint do
    gradle(task: 'lintRelease', project_dir: '..')
  end

  desc "Publish to the internal testing track"
  lane :internal do
    build
    upload_to_play_store(
      track: 'internal',
      release_status: 'completed',
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      aab: 'app/build/outputs/bundle/release/app-release.aab',
    )
  end

  desc "Publish to the beta testing track"
  lane :beta do
    build
    upload_to_play_store(
      track: 'beta',
      release_status: 'completed',
      skip_upload_aab: false,
      aab: 'app/build/outputs/bundle/release/app-release.aab',
    )
  end

  desc "Promote the internal build to beta, then to production"
  lane :promote do
    build
    upload_to_play_store(
      track: 'beta',
      release_status: 'inProgress',
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_screenshots: true,
    )
    upload_to_play_store(
      track: 'production',
      release_status: 'draft',
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Upload the store listing and screenshots without shipping a build"
  lane :metadata do
    upload_to_play_store(
      skip_upload_aab: true,
      skip_upload_changelogs: false,
      skip_upload_screenshots: false,
    )
  end

  private_lane :signing_properties do
    # The release signing values are never committed; CI supplies them as environment variables.
    {
      'RELEASE_STORE_FILE' => ENV['RELEASE_STORE_FILE'],
      'RELEASE_STORE_PASSWORD' => ENV['RELEASE_STORE_PASSWORD'],
      'RELEASE_KEY_ALIAS' => ENV['RELEASE_KEY_ALIAS'],
      'RELEASE_KEY_PASSWORD' => ENV['RELEASE_KEY_PASSWORD'],
    }.compact
  end
end